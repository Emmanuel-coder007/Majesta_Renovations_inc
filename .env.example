# ---------------------------------------------------------------------------
# Majesta Renovations — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Canonical site origin. Used for metadataBase, Open Graph URLs, hreflang
# alternates, sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- EmailJS (client-side quote form delivery) -----------------------------
# See EMAILJS_SETUP.md for step-by-step setup and the exact template
# variable names this codebase sends.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Server-side lead fallback --------------------------------------------
# Directory the /api/contact route writes leads to when EmailJS is missing,
# misconfigured, or fails. Relative to the project root.
# On Vercel the filesystem is read-only outside /tmp, so set this to /tmp/leads
# there (and forward leads onward — see README "Deploying to Vercel").
LEADS_DIR=./data
